{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Requested-With, X-Secret-Key, x-sepay-token, x-api-key" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/payment/status/(.*)", "destination": "/api/payment/status?code=$1" },
    { "source": "/api/social/proxy-download", "destination": "/api/download" },
    { "source": "/api/proxy", "destination": "/api/download" },
    { "source": "/api/youtube-resolve", "destination": "/api/social/extract?action=youtube-resolve" },
    { "source": "/api/youtube-progress", "destination": "/api/social/extract?action=youtube-progress" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
